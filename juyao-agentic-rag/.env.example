# juyao-agentic-rag 环境变量模板
# 复制为 .env 后填入真实值：cp .env.example .env

# --- 必填（使用百炼 / DashScope 能力时）---
DASHSCOPE_API_KEY=

# --- 对话 LLM（可与百炼 Key 分离，例如 MiniMax）---
# LLM_API_KEY=

# --- 可选密钥 ---
OPENAI_API_KEY=
QDRANT_API_KEY=
NEO4J_PASSWORD=
RAG_INGEST_INTERNAL_TOKEN=

# --- 常用覆盖（不配则使用 config/default.toml）---
# EMBED_PROVIDER=ollama          # ollama | dashscope
# EMBED_MODEL=text-embedding-v4
# EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RERANK_PROVIDER=dashscope
# DASHSCOPE_RERANK_MODEL=qwen3-rerank
# DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# GEN_MODEL=qwen3.6-35b-a3b
# QDRANT_URL=http://localhost:6333
# ELASTICSEARCH_URL=http://localhost:9201
# REDIS_URL=redis://localhost:6379/0
# NEO4J_URI=bolt://localhost:7687
# KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
# RAG_API_HOST=0.0.0.0
# RAG_API_PORT=8000

# --- LightRAG 卡片专用模型组（同文件双实例：swarp_config_amd.yaml 补 -card 后缀的第二份 bge）---
# 独立端点或独立模型名任一配置即启用卡片独立并发池（KG_CARD_MAX_CONCURRENCY）；
# 都留空 = 与主组同模型同端点同池，不放大并发。base_url 留空 = 跟随主 llama-swap。
KG_CARD_EMBED_BASE_URL=
KG_CARD_EMBED_MODEL=
KG_CARD_RERANK_PROVIDER=
KG_CARD_RERANK_BASE_URL=
KG_CARD_RERANK_MODEL=
KG_CARD_MAX_CONCURRENCY=10
# 部署第二台模型服务后填写：卡片向量化/重排走独立端点+独立并发池（KG_CARD_MAX_CONCURRENCY），
# 与主链路（chunk 向量化/重排）互不争抢。未填写时与主组同源同池，不放大并发。
KG_CARD_EMBED_BASE_URL=
KG_CARD_EMBED_MODEL=
KG_CARD_RERANK_PROVIDER=
KG_CARD_RERANK_BASE_URL=
KG_CARD_RERANK_MODEL=
KG_CARD_MAX_CONCURRENCY=10
